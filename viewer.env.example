# =============================================================================
# Fork-only: environment of a viewer deployment (see VIEWER_DEPLOYMENT.md).
# Copy to .env beside docker-compose.yml on the viewer server.
#
# docker-compose.viewer.yml sets DATABASE_URL, OPENMAIC_VIEWER_MODE,
# OPENMAIC_ACCOUNTS_ENABLED and OPENMAIC_VIEWER_SNAPSHOT itself. For the folder
# distribution, uncomment the block at the end.
# =============================================================================

# Signs login cookies. Required: a random value of at least 32 characters, for
# example from: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# It may differ from the authoring deployment's; changing it logs everyone out.
OPENMAIC_SESSION_SECRET=

# Optional site password asked before anything is shown. Leave unset for a
# public site.
# ACCESS_CODE=

# Login cookies carry the `Secure` flag, so the site must be served over HTTPS
# (put a reverse proxy with a certificate in front). On a trusted network
# without TLS, the exact value 0 turns the flag off:
# COOKIE_SECURE=0

# Behind a reverse proxy that overwrites x-forwarded-for:
# TRUST_PROXY_HEADERS=true

# Where the app reaches itself for login and course-visibility checks. Needed
# behind a reverse proxy: without it, course pages send visitors back to the
# home page. The compose file and the systemd service set it already.
# OPENMAIC_INTERNAL_URL=http://127.0.0.1:3000

# --- Narration and models -----------------------------------------------------
# openmaic.yml sets the narration voices (browser voices, free) and, optionally,
# chat models. The compose file mounts it; the folder distribution reads it
# from here:
# OPENMAIC_CONFIG=/opt/openmaic-viewer/openmaic.yml
# Only logged-in accounts reach class chat, quiz grading and speech input. To
# offer them, declare a chat model in openmaic.yml and set the key it names:
# OLLAMA_CLOUD_API_KEY=

# How long a statement may wait for the embedded database before it fails
# (milliseconds, default 60000).
# OPENMAIC_EMBEDDED_DB_LOCK_WAIT_MS=60000

# --- Folder distribution only -------------------------------------------------
# DATABASE_URL=pglite:./data/viewer-db
# OPENMAIC_VIEWER_MODE=true
# OPENMAIC_ACCOUNTS_ENABLED=true
# OPENMAIC_VIEWER_SNAPSHOT=./data/viewer-snapshot.ndjson.gz
# PORT=3000
# HOSTNAME=0.0.0.0
